// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Aluno {
  id         String            @id @default(uuid())
  nome       String
  email      String            @unique
  telefone   String?
  status     String            @default("em-dia")
  treino     String?
  objetivo   String
  nivel      String
  peso       Float
  altura     Float
  idade      Int
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  avaliacoes AvaliacaoFisica[]
}

model AvaliacaoFisica {
  id                String   @id @default(uuid())
  alunoId           String
  peso              Float
  altura            Float
  percentualGordura Float?
  massaMuscular     Float?
  braco             Float?
  peitoral          Float?
  cintura           Float?
  quadril           Float?
  coxa              Float?
  panturrilha       Float?
  observacoes       String?
  dataAvaliacao     DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@index([alunoId])
}

model Treino {
  id         String            @id @default(uuid())
  nome       String
  objetivo   String
  descricao  String?
  duracao    Int?
  status     String            @default("disponivel")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  exercicios TreinoExercicio[]
}

model Exercicio {
  id        String            @id @default(uuid())
  nome      String
  categoria String
  descricao String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  treinos   TreinoExercicio[]
}

model TreinoExercicio {
  id          String @id @default(uuid())
  treinoId    String
  exercicioId String
  ordem       Int
  series      Int
  repeticoes  Int
  carga       Float?

  treino    Treino    @relation(fields: [treinoId], references: [id], onDelete: Cascade)
  exercicio Exercicio @relation(fields: [exercicioId], references: [id], onDelete: Restrict)

  @@unique([treinoId, exercicioId])
  @@index([treinoId])
  @@index([exercicioId])
}
